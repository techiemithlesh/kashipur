server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} ${API_DOMAIN};
    client_max_body_size 12m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 503 "TLS certificate is not available yet\n";
    }
}

