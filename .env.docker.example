SWM_ENV_FILE=.env.docker.example
IMAGE_TAG=local
DOMAIN=localhost
API_DOMAIN=localhost
ACME_EMAIL=ops@example.com
SWM_DATA_ROOT=./.local-data

APP_NAME=SWM
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:8080

VITE_REACT_APP_BACKEND_API=http://localhost:8080
VITE_REACT_APP_ULB_ID=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_STREET_LABELS_URL=
VITE_MAP_PLACE_LABELS_URL=
VITE_ROUTING_URL=
REVERB_APP_ID=swm
REVERB_APP_KEY=local-public-key
REVERB_APP_SECRET=local-only-secret

REDIS_PASSWORD=local-only-redis-password
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=db_swm_master
DB_USERNAME=swm_user
DB_PASSWORD=replace_with_local_database_password
DB_READ_PORT=5432
DB_READ_DATABASE=db_swm_master
DB_READ_USERNAME=swm_user
DB_READ_PASSWORD=replace_with_local_database_password
DB_CONSUMER_PORT=5432
DB_CONSUMER_DATABASE=db_swm_consumer
DB_CONSUMER_USERNAME=swm_user
DB_CONSUMER_PASSWORD=replace_with_local_database_password
DB_CONSUMER_READ_PORT=5432
DB_CONSUMER_READ_DATABASE=db_swm_consumer
DB_CONSUMER_READ_USERNAME=swm_user
DB_CONSUMER_READ_PASSWORD=replace_with_local_database_password

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME=SWM
SMS_TEST=true
