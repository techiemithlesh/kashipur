# Copy to .env.docker, replace placeholders, and keep .env.docker out of Git.
# APP_URL and VITE_REACT_APP_BACKEND_API must match the public Nginx origin.
# This origin is for local Docker testing only; set your real HTTPS origin for production.
APP_NAME=SWM
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_GENERATED_LARAVEL_KEY
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1

# These credentials are for PostgreSQL bootstrap and the two Laravel database users.
POSTGRES_ADMIN_USER=swm_bootstrap
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db_swm_master
DB_USERNAME=swm_master_user
DB_PASSWORD=REPLACE_WITH_A_DISTINCT_LONG_RANDOM_PASSWORD

DB_CONSUMER_HOST=db
DB_CONSUMER_PORT=5432
DB_CONSUMER_DATABASE=db_swm_consumer
DB_CONSUMER_USERNAME=swm_consumer_user
DB_CONSUMER_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=public

# Vite values are public build-time values and are embedded in the frontend bundle.
# Do not put passwords, private API keys, or other secrets in VITE_* variables.
VITE_REACT_APP_BACKEND_API=http://localhost:8080
VITE_REACT_APP_ULB_ID=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_STREET_LABELS_URL=
VITE_MAP_PLACE_LABELS_URL=
VITE_ROUTING_URL=

# Realtime (Laravel Reverb). Generate with: openssl rand -hex 16 (key) / -hex 32 (secret).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=REPLACE_WITH_A_NUMERIC_ID
REVERB_APP_KEY=REPLACE_WITH_A_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Browser-facing WebSocket endpoint (nginx proxies /app to Reverb). Production: your domain, 443, https.
VITE_REVERB_APP_KEY=SAME_AS_REVERB_APP_KEY
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
