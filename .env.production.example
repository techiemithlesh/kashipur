SWM_ENV_FILE=.env.production
IMAGE_TAG=latest
DOMAIN=kashipurcontrolcentre.com
API_DOMAIN=api.kashipurcontrolcentre.com
ACME_EMAIL=replace_with_lets_encrypt_email
SWM_DATA_ROOT=/data/swm

APP_NAME=SWM
APP_KEY=replace_with_base64_laravel_app_key
APP_URL=https://api.kashipurcontrolcentre.com
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
ALLOWED_ORIGINS=https://kashipurcontrolcentre.com

VITE_REACT_APP_BACKEND_API=https://api.kashipurcontrolcentre.com
VITE_REACT_APP_ULB_ID=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_STREET_LABELS_URL=
VITE_MAP_PLACE_LABELS_URL=
VITE_ROUTING_URL=
REVERB_APP_ID=swm
REVERB_APP_KEY=replace_with_reverb_app_key
REVERB_APP_SECRET=replace_with_reverb_app_secret

REDIS_PASSWORD=replace_with_unique_redis_password
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=db_swm_master
DB_USERNAME=swm_user
DB_PASSWORD=replace_with_postgresql_password
DB_READ_PORT=5432
DB_READ_DATABASE=db_swm_master
DB_READ_USERNAME=swm_user
DB_READ_PASSWORD=replace_with_postgresql_password
DB_CONSUMER_PORT=5432
DB_CONSUMER_DATABASE=db_swm_consumer
DB_CONSUMER_USERNAME=swm_user
DB_CONSUMER_PASSWORD=replace_with_postgresql_password
DB_CONSUMER_READ_PORT=5432
DB_CONSUMER_READ_DATABASE=db_swm_consumer
DB_CONSUMER_READ_USERNAME=swm_user
DB_CONSUMER_READ_PASSWORD=replace_with_postgresql_password

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@kashipurcontrolcentre.com
MAIL_FROM_NAME=SWM
SMS_TEST=true
