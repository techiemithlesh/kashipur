# Production env for the Hostinger VPS. Copy to /opt/swm/.env.production, fill in, then:
#   chmod 600 .env.production
# Never commit the filled-in file. Generate secrets with: openssl rand -base64 36
# APP_KEY: docker run --rm swm-backend:<tag> php artisan key:generate --show

# --- Domain / TLS --------------------------------------------------------------------
DOMAIN=swm.example.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=ops@example.com

# --- Laravel -------------------------------------------------------------------------
APP_NAME=SWM
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_GENERATED_LARAVEL_KEY
APP_DEBUG=false
APP_URL=https://swm.example.com
# Extra origins allowed to call the API cross-site (comma-separated). Same-origin needs none.
ALLOWED_ORIGINS=https://swm.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- PostgreSQL (in Docker, reachable only via SSH tunnel on 127.0.0.1:DB_ADMIN_PORT) ---
DB_ADMIN_PORT=5432
POSTGRES_ADMIN_USER=swm_bootstrap
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

DB_CONNECTION=pgsql
DB_DATABASE=db_swm_master
DB_USERNAME=swm_master_user
DB_PASSWORD=REPLACE_WITH_A_DISTINCT_LONG_RANDOM_PASSWORD

DB_CONSUMER_DATABASE=db_swm_consumer
DB_CONSUMER_USERNAME=swm_consumer_user
DB_CONSUMER_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# --- Redis / queues / cache ----------------------------------------------------------
REDIS_CLIENT=predis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=public

# --- Realtime (Laravel Reverb), served at wss://DOMAIN/app ----------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=REPLACE_WITH_A_NUMERIC_ID
REVERB_APP_KEY=REPLACE_WITH_A_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# --- Frontend build (PUBLIC: embedded in the JS bundle, never put secrets here) --------
VITE_REACT_APP_BACKEND_API=https://swm.example.com
VITE_REACT_APP_ULB_ID=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_STREET_LABELS_URL=
VITE_MAP_PLACE_LABELS_URL=
VITE_ROUTING_URL=
VITE_REVERB_APP_KEY=SAME_AS_REVERB_APP_KEY
VITE_REVERB_HOST=swm.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Backups (deploy/scripts/backup-db.sh) --------------------------------------------
BACKUP_DIR=/opt/swm/backups
BACKUP_RETENTION_DAYS=14
